# ==============================================================================
# LGA — Logical Git Aliases
# https://github.com/rockberpro/git-lga
#
# Pattern: [prefix (2-3 chars)] + [suffix (first letter of the flag)]
# Example: cm = commit, cmm = commit --message, cma = commit --amend
#
# Install:
#   curl -sL https://raw.githubusercontent.com/rockberpro/git-lga/main/setup.sh | bash
#
# Manual install:
#   git config --global include.path ~/.git-lga.gitconfig
# ==============================================================================

[alias]
    # --- ADD (ad) ---
    ad  = add
    ada = add .
    adp = add --patch
    adu = add --update

    # --- BRANCH (br) ---
    br  = branch
    brd = branch --delete
    brl = branch --list
    bra = branch --all
    brf = branch --delete --force
    brm = branch --move
    brs = branch --show-current

    # --- COMMIT (cm) ---
    cm  = commit
    cmf = commit --fixup
    cma = commit --amend
    cmn = commit --amend --no-edit
    cmm = commit --message

    # --- CHECKOUT / SWITCH / RESTORE ---
    ck  = checkout
    sw  = switch
    swc = switch --create
    rs  = restore
    rsa = restore .
    rss = restore --staged

    # --- DIFF (df) ---
    df   = diff
    dfc  = diff --cached
    dfi  = diff --ignore-all-space
    dfw  = diff --word-diff
    dfs  = diff --stat

    # --- FETCH / PULL / PUSH ---
    ft   = fetch
    ftp  = fetch --prune
    fta  = fetch --all
    pl   = pull
    plh  = pull origin HEAD
    plr  = pull --rebase
    ps   = push
    psf  = push --force-with-lease
    psh  = push origin HEAD
    pshf = push origin HEAD --force-with-lease
    psu  = push --set-upstream

    # --- LOG / SHOW ---
    lg  = log
    lgh = log HEAD
    lgp = log --patch
    lgo = log --graph --oneline --decorate --all
    sh  = show --patch

    # --- MERGE / REBASE ---
    mg  = merge
    mga = merge --abort
    mgc = merge --continue
    mgs = merge --squash
    rb  = rebase
    rba = rebase --abort
    rbc = rebase --continue
    rbi = rebase --interactive
    rbo = rebase --onto
    rbs = rebase --skip

    # --- STASH (sth) ---
    sth  = stash
    sthc = stash clear
    sthd = stash drop
    sthl = stash list
    stho = stash pop
    sthp = stash push
    stha = stash apply
    sths = stash show --patch
    sthu = stash push --include-untracked

    # --- STATUS (st) ---
    st  = status
    sts = status --short --branch

    # --- WORKTREE (wt) ---
    wt  = worktree
    wta = worktree add
    wtl = worktree list
    wtm = worktree move
    wtp = worktree prune
    wtr = worktree remove

    # --- BISECT (bs) ---
    bs  = bisect
    bsb = bisect bad
    bsg = bisect good
    bsr = bisect reset
    bss = bisect start

    # --- REFLOG (rl) ---
    rl  = reflog

    # --- SUBMODULE (sm) ---
    sm  = submodule
    smu = submodule update --init --recursive

    # --- UTILS ---
    bl   = blame
    cfg  = config
    cfgl = config --list
    cln  = clean
    clf  = clean --force
    clfd = clean --force -d
    clo  = clone
    chp  = cherry-pick
    chpa = cherry-pick --abort
    chpc = cherry-pick --continue
    chps = cherry-pick --skip
    ds   = describe
    gp   = grep
    in   = init
    rt   = remote
    rtv  = remote --verbose
    rv   = revert
    rva  = revert --abort
    rvc  = revert --continue
    tg   = tag
    tgd  = tag --delete
    rst  = reset
    rsth = reset --hard
    rsts = reset --soft
    lga  = !~/.git-lga-help.sh
